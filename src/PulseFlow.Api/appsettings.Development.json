{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=pulseflow_db;Username=pulseflow_user;Password=pulseflow_password;Include Error Detail=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Logging": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  }
}
